    { "id": "north", "name": "Северное месторождение", "kind": "metal", "anchor": "north", "radius": 0.23, "spots": 20 },
    { "id": "south", "name": "Южное месторождение", "kind": "metal", "anchor": "south", "radius": 0.23, "spots": 20 },
    { "id": "walls", "name": "Блокеры у входов", "kind": "blocker", "anchor": "players", "offset": [0, 0.53], "radius": 0.06, "chain": { "count": 3, "step": 0.095, "gap": 0.14 } },
