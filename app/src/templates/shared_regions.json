  "links": [
    { "from": "starts", "to": "home", "match": "owner" },
    { "from": "starts", "to": "passes", "match": "owner" },
    { "from": "passes", "to": "north", "match": "all" },
    { "from": "starts", "to": "south", "match": "all" },
    { "from": "passes", "to": "walls", "match": "owner" }
