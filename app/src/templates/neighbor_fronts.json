{
  "version": 1,
  "id": "neighbor_fronts",
  "name": "Соседние фронты",
  "description": "У каждой стороны есть домашний металл и два соседних фронта. Цепочки блокеров оставляют проходы к спорным месторождениям.",
  "players": { "min": 3, "max": 12, "default": 4 },
  "nodes": [
    { "id": "starts", "name": "Стартовые области", "kind": "spawn", "anchor": "players", "radius": 0.11 },
    { "id": "home", "name": "Домашний металл", "kind": "metal", "anchor": "players", "offset": [0, 0.22], "radius": 0.085, "spots": 7 },
    { "id": "front", "name": "Спорный металл", "kind": "metal", "anchor": "fronts", "radius": 0.10, "spots": 10 },
    { "id": "walls", "name": "Границы фронтов", "kind": "blocker", "anchor": "fronts", "radius": 0.055, "chain": { "count": 4, "step": 0.085, "gap": 0.13 }, "offset": [0, -0.24] },
    { "id": "passes", "name": "Проходы", "kind": "ramp", "anchor": "fronts", "radius": 0.065, "offset": [0, -0.24] }
  ],
  "links": [
    { "from": "starts", "to": "home", "match": "owner" },
    { "from": "starts", "to": "front", "match": "adjacent" },
    { "from": "front", "to": "passes", "match": "owner" },
    { "from": "passes", "to": "walls", "match": "owner" }
  ]
}
